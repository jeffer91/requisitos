rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function validIdentification(value) {
      return value is string && value.matches('^[0-9A-Za-z]{6,20}$');
    }

    function validPeriod(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}__[0-9]{4}-[0-9]{2}$');
    }

    function validMetadata(data) {
      return (!('version' in data) || (data.version is int && data.version >= 1))
        && (!('dataHash' in data) || data.dataHash is string)
        && (!('updatedAt' in data) || data.updatedAt is string || data.updatedAt is timestamp)
        && (!('createdAt' in data) || data.createdAt is string || data.createdAt is timestamp)
        && (!('eliminado' in data) || data.eliminado is bool);
    }

    function validStudentPeriodDocument(documentId, data) {
      return validPeriod(data.periodoId)
        && validIdentification(data.cedula)
        && documentId == data.periodoId + '__' + data.cedula
        && validMetadata(data);
    }

    function validOptionalPeriod(data) {
      return !('periodoId' in data) || validPeriod(data.periodoId);
    }

    function validReportGroup(data) {
      return data.grupoInforme is string
        && (data.grupoInforme == 'PRESENCIAL'
          || data.grupoInforme == 'ONLINE'
          || data.grupoInforme == 'PVC');
    }

    /* Colección física oficial de estudiantes. */
    match /Estudiante/{identificacion} {
      allow read: if true;
      allow create, update: if validIdentification(identificacion)
        && request.resource.data.cedula == identificacion
        && validMetadata(request.resource.data);
      allow delete: if false;
    }

    match /matriculas/{documentId} {
      allow read: if true;
      allow create, update: if validStudentPeriodDocument(documentId, request.resource.data);
      allow delete: if false;
    }

    match /requisitos/{documentId} {
      allow read: if true;
      allow create, update: if validStudentPeriodDocument(documentId, request.resource.data);
      allow delete: if false;
    }

    match /notas/{documentId} {
      allow read: if true;
      allow create, update: if validStudentPeriodDocument(documentId, request.resource.data);
      allow delete: if false;
    }

    match /periodos/{periodoId} {
      allow read: if true;
      allow create, update: if validPeriod(periodoId)
        && request.resource.data.periodoId == periodoId
        && validMetadata(request.resource.data);
      allow delete: if false;
    }

    match /carreras/{codigoCarrera} {
      allow read: if true;
      allow create, update: if codigoCarrera is string
        && codigoCarrera.size() > 0
        && request.resource.data.codigoCarrera == codigoCarrera
        && validMetadata(request.resource.data);
      allow delete: if false;
    }

    match /importaciones/{documentId} {
      allow read: if true;
      allow create, update: if documentId.size() > 0
        && validOptionalPeriod(request.resource.data)
        && validMetadata(request.resource.data);
      allow delete: if false;
    }

    match /historial/{documentId} {
      allow read: if true;
      allow create, update: if documentId.size() > 0
        && validOptionalPeriod(request.resource.data)
        && validMetadata(request.resource.data);
      allow delete: if false;
    }

    /* =========================================================
       MENÚ NOTAS — colecciones oficiales de calificaciones.
       Escritura directa igual que Carga: sin Firebase Auth, con validación
       estructural y sin borrados.
         notas_nucleos     Núcleos (Ncomplex)        periodoId__cedula__N1..N4
         notas_complexivo  Examen complexivo (Ncomplex) periodoId__cedula
         notas_articulo    Artículo académico         periodoId__cedula
         notas_trabajo     Acta SENESCYT de trabajo   periodoId__cedula
       ========================================================= */
    function validGrade(value) {return value is number && value >= 0 && value <= 10;}
    function validOptionalGrade(data, field) {
      return !(field in data) || data[field] == null || validGrade(data[field]);
    }

    match /notas_nucleos/{documentId} {
      allow read: if true;
      allow create, update: if validPeriod(request.resource.data.periodoId)
        && validIdentification(request.resource.data.cedula)
        && request.resource.data.nucleo is int
        && request.resource.data.nucleo >= 1
        && request.resource.data.nucleo <= 4
        && validReportGroup(request.resource.data)
        && request.resource.data.evaluaciones is list
        && request.resource.data.evaluaciones.size() == 4
        && documentId == request.resource.data.periodoId + '__' +
          request.resource.data.cedula + '__N' + string(request.resource.data.nucleo)
        && validMetadata(request.resource.data);
      allow delete: if false;
    }

    function validComplexivoDocument(documentId, data) {
      return data.keys().hasAll([
          'periodoId','cedula','grupoInforme','modalidadTitulacion',
          'oportunidadAplicada','estadoEvaluacion','notaOficial','dataHash'
        ])
        && validStudentPeriodDocument(documentId, data)
        && validReportGroup(data)
        && data.modalidadTitulacion == 'EXAMEN_COMPLEXIVO'
        && data.dataHash is string
        && data.estadoEvaluacion is string
        && validGrade(data.notaOficial)
        && (
          (data.oportunidadAplicada == 'ORDINARIA' &&
            validGrade(data.notaTeorica) &&
            validGrade(data.notaPractica))
          || (data.oportunidadAplicada == 'SUPLETORIO' &&
            validGrade(data.notaTeoricaSupletorio) &&
            validGrade(data.notaPracticaSupletorio))
        );
    }
    match /notas_complexivo/{documentId} {
      allow read: if true;
      allow create, update: if validComplexivoDocument(documentId, request.resource.data);
      allow delete: if false;
    }

    match /notas_articulo/{documentId} {
      allow read: if true;
      allow create, update: if validStudentPeriodDocument(documentId, request.resource.data)
        && validOptionalGrade(request.resource.data, 'notaArticulo')
        && validOptionalGrade(request.resource.data, 'notaDefensa')
        && validOptionalGrade(request.resource.data, 'notaFinal');
      allow delete: if false;
    }

    match /notas_trabajo/{documentId} {
      allow read: if true;
      allow create, update: if validStudentPeriodDocument(documentId, request.resource.data)
        && request.resource.data.modalidadTitulacion == 'TRABAJO_TITULACION'
        && (
          (request.resource.data.get('tipoRegistro','') == 'CONSOLIDADO_INSTITUCIONAL'
            && validGrade(request.resource.data.promedioTrabajoEscrito)
            && validGrade(request.resource.data.promedioDefensaOral)
            && validGrade(request.resource.data.notaFinal)
            && validReportGroup(request.resource.data))
          || (
            request.resource.data.numeroActaSenescyt is string
            && request.resource.data.numeroActaSenescyt.matches('^[0-9]+
      allow delete: if false;
    }

    /* Colecciones antiguas: solo lectura. Nada las escribe ya; las notas viven
       en las colecciones notas_* de arriba. */
    match /nucleos/{documentId} { allow read: if true; allow write: if false; }
    match /complexivo/{documentId} { allow read: if true; allow write: if false; }
    match /evaluaciones_nucleos/{documentId} { allow read: if true; allow write: if false; }
    match /complexivos/{documentId} { allow read: if true; allow write: if false; }

    match /titulacion/{documentId} {
      allow read: if true;
      allow create, update: if validStudentPeriodDocument(documentId, request.resource.data)
        && validReportGroup(request.resource.data);
      allow delete: if false;
    }

    match /cronogramas/{documentId} {
      allow read: if true;
      allow create, update: if validPeriod(request.resource.data.periodoId)
        && validReportGroup(request.resource.data)
        && documentId == request.resource.data.periodoId + '__' + request.resource.data.grupoInforme
        && validMetadata(request.resource.data);
      allow delete: if false;
    }

    /* Folios de acta: transacciones atómicas y registros inmutables.
     * PENDIENTE: implantar Auth y permisos institucionales antes de despliegue.
     */
    function validMonthActa(value) {
      return value is string && value.matches('^[0-9]{4}-(0[1-9]|1[0-2])$');
    }
    function validNumberActa(value) {
      return value is string && (value.matches('^[0-9]{4}-[0-9]{4}-(0[1-9]|1[0-2])-[0-9]{4}$') || value.matches('^(CX|TT)-[0-9]{4}-[0-9]{4}-(0[1-9]|1[0-2])-[0-9]{4}$'));
    }
    function validActaEntry(id,data) {
      return data.keys().hasAll(['identidad','numeroActa','periodoId','cedula','modalidad','mesClave','consecutivo','fechaEmision','estado'])
        && data.identidad == id
        && data.cedula is string && data.cedula.matches('^[0-9]{10}$')
        && validPeriod(data.periodoId)
        && id == data.periodoId + '__' + data.cedula
        && validNumberActa(data.numeroActa)
        && ((data.modalidad == 'EXAMEN_COMPLEXIVO' && data.numeroActa.matches('^CX-[0-9]{4}-[0-9]{4}-(0[1-9]|1[0-2])-[0-9]{4}$')) || (data.modalidad == 'TRABAJO_TITULACION' && data.numeroActa.matches('^TT-[0-9]{4}-[0-9]{4}-(0[1-9]|1[0-2])-[0-9]{4}$')))
        && validMonthActa(data.mesClave)
        && data.fechaEmision is string && data.fechaEmision.matches('^[0-9]{4}-(0[1-9]|1[0-2])-[0-9]{2}$')
        && data.consecutivo is int && data.consecutivo >= 1 && data.consecutivo <= 9999
        && data.estado == 'REGISTRADA'
        && (data.modalidad == 'EXAMEN_COMPLEXIVO' || data.modalidad == 'TRABAJO_TITULACION');
    }
    match /actas_contadores/{mesClave} {
      allow read: if true;
      allow create: if validMonthActa(mesClave)
        && request.resource.data.mesClave == mesClave
        && request.resource.data.ultimo == 1
        && validNumberActa(request.resource.data.ultimaActa)
        && getAfter(/databases/$(database)/documents/actas_numeros/$(request.resource.data.ultimaActa)).data.identidad == request.resource.data.ultimaIdentidad
        && getAfter(/databases/$(database)/documents/actas_registro/$(request.resource.data.ultimaIdentidad)).data.numeroActa == request.resource.data.ultimaActa;
      allow update: if validMonthActa(mesClave)
        && request.resource.data.mesClave == mesClave
        && request.resource.data.ultimo is int
        && request.resource.data.ultimo == resource.data.ultimo + 1
        && request.resource.data.ultimo <= 9999
        && validNumberActa(request.resource.data.ultimaActa)
        && getAfter(/databases/$(database)/documents/actas_numeros/$(request.resource.data.ultimaActa)).data.identidad == request.resource.data.ultimaIdentidad
        && getAfter(/databases/$(database)/documents/actas_registro/$(request.resource.data.ultimaIdentidad)).data.numeroActa == request.resource.data.ultimaActa;
      allow delete: if false;
    }
    match /actas_registro/{identidad} {
      allow read: if true;
      allow create: if validActaEntry(identidad,request.resource.data)
        && getAfter(/databases/$(database)/documents/actas_numeros/$(request.resource.data.numeroActa)).data.identidad == identidad
        && getAfter(/databases/$(database)/documents/actas_contadores/$(request.resource.data.mesClave)).data.ultimaActa == request.resource.data.numeroActa
        && getAfter(/databases/$(database)/documents/actas_contadores/$(request.resource.data.mesClave)).data.ultimo == request.resource.data.consecutivo;
      allow update, delete: if false;
    }
    match /actas_numeros/{numero} {
      allow read: if true;
      allow create: if validNumberActa(numero)
        && request.resource.data.numeroActa == numero
        && validMonthActa(request.resource.data.mesClave)
        && getAfter(/databases/$(database)/documents/actas_registro/$(request.resource.data.identidad)).data.numeroActa == numero
        && getAfter(/databases/$(database)/documents/actas_contadores/$(request.resource.data.mesClave)).data.ultimaActa == numero
        && getAfter(/databases/$(database)/documents/actas_contadores/$(request.resource.data.mesClave)).data.ultimo == request.resource.data.consecutivo;
      allow update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
)
            && validGrade(request.resource.data.calificacionTutor)
            && validGrade(request.resource.data.calificacionLector)
            && validGrade(request.resource.data.promedioTrabajoEscrito)
            && validGrade(request.resource.data.promedioEvaluacionPractica)
            && validGrade(request.resource.data.promedioEvaluacionDefensa)
            && validGrade(request.resource.data.promedioDefensaOral)
            && validGrade(request.resource.data.notaFinal)
            && request.resource.data.vocales is list
            && request.resource.data.vocales.size() == 3)
        );
      allow delete: if false;
    }

    /* Colecciones antiguas: solo lectura. Nada las escribe ya; las notas viven
       en las colecciones notas_* de arriba. */
    match /nucleos/{documentId} { allow read: if true; allow write: if false; }
    match /complexivo/{documentId} { allow read: if true; allow write: if false; }
    match /evaluaciones_nucleos/{documentId} { allow read: if true; allow write: if false; }
    match /complexivos/{documentId} { allow read: if true; allow write: if false; }

    match /titulacion/{documentId} {
      allow read: if true;
      allow create, update: if validStudentPeriodDocument(documentId, request.resource.data)
        && validReportGroup(request.resource.data);
      allow delete: if false;
    }

    match /cronogramas/{documentId} {
      allow read: if true;
      allow create, update: if validPeriod(request.resource.data.periodoId)
        && validReportGroup(request.resource.data)
        && documentId == request.resource.data.periodoId + '__' + request.resource.data.grupoInforme
        && validMetadata(request.resource.data);
      allow delete: if false;
    }

    /* Folios de acta: transacciones atómicas y registros inmutables.
     * PENDIENTE: implantar Auth y permisos institucionales antes de despliegue.
     */
    function validMonthActa(value) {
      return value is string && value.matches('^[0-9]{4}-(0[1-9]|1[0-2])$');
    }
    function validNumberActa(value) {
      return value is string && (value.matches('^[0-9]{4}-[0-9]{4}-(0[1-9]|1[0-2])-[0-9]{4}$') || value.matches('^(CX|TT)-[0-9]{4}-[0-9]{4}-(0[1-9]|1[0-2])-[0-9]{4}$'));
    }
    function validActaEntry(id,data) {
      return data.keys().hasAll(['identidad','numeroActa','periodoId','cedula','modalidad','mesClave','consecutivo','fechaEmision','estado'])
        && data.identidad == id
        && data.cedula is string && data.cedula.matches('^[0-9]{10}$')
        && validPeriod(data.periodoId)
        && id == data.periodoId + '__' + data.cedula
        && validNumberActa(data.numeroActa)
        && ((data.modalidad == 'EXAMEN_COMPLEXIVO' && data.numeroActa.matches('^CX-[0-9]{4}-[0-9]{4}-(0[1-9]|1[0-2])-[0-9]{4}$')) || (data.modalidad == 'TRABAJO_TITULACION' && data.numeroActa.matches('^TT-[0-9]{4}-[0-9]{4}-(0[1-9]|1[0-2])-[0-9]{4}$')))
        && validMonthActa(data.mesClave)
        && data.fechaEmision is string && data.fechaEmision.matches('^[0-9]{4}-(0[1-9]|1[0-2])-[0-9]{2}$')
        && data.consecutivo is int && data.consecutivo >= 1 && data.consecutivo <= 9999
        && data.estado == 'REGISTRADA'
        && (data.modalidad == 'EXAMEN_COMPLEXIVO' || data.modalidad == 'TRABAJO_TITULACION');
    }
    match /actas_contadores/{mesClave} {
      allow read: if true;
      allow create: if validMonthActa(mesClave)
        && request.resource.data.mesClave == mesClave
        && request.resource.data.ultimo == 1
        && validNumberActa(request.resource.data.ultimaActa)
        && getAfter(/databases/$(database)/documents/actas_numeros/$(request.resource.data.ultimaActa)).data.identidad == request.resource.data.ultimaIdentidad
        && getAfter(/databases/$(database)/documents/actas_registro/$(request.resource.data.ultimaIdentidad)).data.numeroActa == request.resource.data.ultimaActa;
      allow update: if validMonthActa(mesClave)
        && request.resource.data.mesClave == mesClave
        && request.resource.data.ultimo is int
        && request.resource.data.ultimo == resource.data.ultimo + 1
        && request.resource.data.ultimo <= 9999
        && validNumberActa(request.resource.data.ultimaActa)
        && getAfter(/databases/$(database)/documents/actas_numeros/$(request.resource.data.ultimaActa)).data.identidad == request.resource.data.ultimaIdentidad
        && getAfter(/databases/$(database)/documents/actas_registro/$(request.resource.data.ultimaIdentidad)).data.numeroActa == request.resource.data.ultimaActa;
      allow delete: if false;
    }
    match /actas_registro/{identidad} {
      allow read: if true;
      allow create: if validActaEntry(identidad,request.resource.data)
        && getAfter(/databases/$(database)/documents/actas_numeros/$(request.resource.data.numeroActa)).data.identidad == identidad
        && getAfter(/databases/$(database)/documents/actas_contadores/$(request.resource.data.mesClave)).data.ultimaActa == request.resource.data.numeroActa
        && getAfter(/databases/$(database)/documents/actas_contadores/$(request.resource.data.mesClave)).data.ultimo == request.resource.data.consecutivo;
      allow update, delete: if false;
    }
    match /actas_numeros/{numero} {
      allow read: if true;
      allow create: if validNumberActa(numero)
        && request.resource.data.numeroActa == numero
        && validMonthActa(request.resource.data.mesClave)
        && getAfter(/databases/$(database)/documents/actas_registro/$(request.resource.data.identidad)).data.numeroActa == numero
        && getAfter(/databases/$(database)/documents/actas_contadores/$(request.resource.data.mesClave)).data.ultimaActa == numero
        && getAfter(/databases/$(database)/documents/actas_contadores/$(request.resource.data.mesClave)).data.ultimo == request.resource.data.consecutivo;
      allow update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
