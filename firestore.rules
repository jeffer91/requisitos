rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function validIdentification(value) {
      return value is string && value.matches('^[0-9A-Za-z]{6,20}$');
    }

    function validPeriod(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}__[0-9]{4}-[0-9]{2}$');
    }

    function validMetadata(data) {
      return (!('version' in data) || (data.version is int && data.version >= 1))
        && (!('dataHash' in data) || data.dataHash is string)
        && (!('updatedAt' in data) || data.updatedAt is string || data.updatedAt is timestamp)
        && (!('createdAt' in data) || data.createdAt is string || data.createdAt is timestamp)
        && (!('eliminado' in data) || data.eliminado is bool);
    }

    function validStudentPeriodDocument(documentId, data) {
      return validPeriod(data.periodoId)
        && validIdentification(data.cedula)
        && documentId == data.periodoId + '__' + data.cedula
        && validMetadata(data);
    }

    function validOptionalPeriod(data) {
      return !('periodoId' in data) || validPeriod(data.periodoId);
    }

    function validReportGroup(data) {
      return data.grupoInforme is string
        && (data.grupoInforme == 'PRESENCIAL'
          || data.grupoInforme == 'ONLINE'
          || data.grupoInforme == 'PVC');
    }

    /* Colección física oficial de estudiantes. */
    match /Estudiante/{identificacion} {
      allow read: if true;
      allow create, update: if validIdentification(identificacion)
        && request.resource.data.cedula == identificacion
        && validMetadata(request.resource.data);
      allow delete: if false;
    }

    match /matriculas/{documentId} {
      allow read: if true;
      allow create, update: if validStudentPeriodDocument(documentId, request.resource.data);
      allow delete: if false;
    }

    match /requisitos/{documentId} {
      allow read: if true;
      allow create, update: if validStudentPeriodDocument(documentId, request.resource.data);
      allow delete: if false;
    }

    match /notas/{documentId} {
      allow read: if true;
      allow create, update: if validStudentPeriodDocument(documentId, request.resource.data);
      allow delete: if false;
    }

    match /periodos/{periodoId} {
      allow read: if true;
      allow create, update: if validPeriod(periodoId)
        && request.resource.data.periodoId == periodoId
        && validMetadata(request.resource.data);
      allow delete: if false;
    }

    match /carreras/{codigoCarrera} {
      allow read: if true;
      allow create, update: if codigoCarrera is string
        && codigoCarrera.size() > 0
        && request.resource.data.codigoCarrera == codigoCarrera
        && validMetadata(request.resource.data);
      allow delete: if false;
    }

    match /importaciones/{documentId} {
      allow read: if true;
      allow create, update: if documentId.size() > 0
        && validOptionalPeriod(request.resource.data)
        && validMetadata(request.resource.data);
      allow delete: if false;
    }

    match /historial/{documentId} {
      allow read: if true;
      allow create, update: if documentId.size() > 0
        && validOptionalPeriod(request.resource.data)
        && validMetadata(request.resource.data);
      allow delete: if false;
    }

    /* Colecciones nuevas de Informtit. No modifican las colecciones oficiales existentes. */
    match /nucleos/{documentId} {
      allow read: if true;
      allow create, update: if validPeriod(request.resource.data.periodoId)
        && validReportGroup(request.resource.data)
        && request.resource.data.nucleo is int
        && request.resource.data.nucleo >= 1
        && documentId.matches('^[0-9]{4}-[0-9]{2}__[0-9]{4}-[0-9]{2}__.+__N[0-9]+$')
        && validMetadata(request.resource.data);
      allow delete: if false;
    }

    match /complexivo/{documentId} {
      allow read: if true;
      allow create, update: if validStudentPeriodDocument(documentId, request.resource.data)
        && validReportGroup(request.resource.data);
      allow delete: if false;
    }

    match /titulacion/{documentId} {
      allow read: if true;
      allow create, update: if validStudentPeriodDocument(documentId, request.resource.data)
        && validReportGroup(request.resource.data);
      allow delete: if false;
    }

    match /cronogramas/{documentId} {
      allow read: if true;
      allow create, update: if validPeriod(request.resource.data.periodoId)
        && validReportGroup(request.resource.data)
        && documentId == request.resource.data.periodoId + '__' + request.resource.data.grupoInforme
        && validMetadata(request.resource.data);
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
